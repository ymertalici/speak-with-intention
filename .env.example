# ============================================================
# Speak with Intention — Vercel ortam değişkenleri
# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# Vercel'de: Proje > Settings > Environment Variables
# ============================================================

# NextAuth oturum gizliliği (en az 32 karakterlik rastgele dize)
# Üretmek için: openssl rand -base64 32
AUTH_SECRET=
# Uygulamanın canlı adresi (Vercel'e bağladıktan sonra güncelle)
NEXTAUTH_URL=https://senin-siten.vercel.app

# Veritabanı — MySQL 8+ uyumlu uzak veritabanı gerekli.
# Öneriler: Neon MySQL (console.neon.tech), Aiven for MySQL, PlanetScale.
# ÖRNEK: mysql://kullanici:sifre@host:3306/veritabani
DATABASE_URL=

# Yapay zekâ sağlayıcısı — OpenAI uyumlu herhangi bir API olabilir
# (OpenAI, Groq, Together, OpenRouter, kendi endpoint'iniz vb.)
# Örnek: https://api.openai.com/v1
AI_API_BASE_URL=
AI_API_KEY=
# İsteğe bağlı: model adı (boş bırakılırsa gpt-4o-mini kullanılır)
AI_MODEL=

# İlk kayıt olan hesabın yönetici olması istenen e-posta (opsiyonel)
AUTO_ADMIN_EMAIL=
# Yeni hesap açılışında istenen kayıt kodu (opsiyonel; boşsa herkese açık kayıt)
REGISTER_CODE=
